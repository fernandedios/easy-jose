{
  "name": "easy-jose",
  "version": "2.0.0",
  "description": "Straightforward JOSE helpers: encrypt (JWE), sign (JWS) and issue JWTs with a few function calls. Built on jose; runs in Node.js, Deno, Bun, browsers and edge runtimes.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\" \"test/*.test.cjs\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm test && npm run typecheck"
  },
  "keywords": [
    "jose",
    "jwe",
    "jws",
    "jwt",
    "jwk",
    "encryption",
    "signing",
    "webcrypto"
  ],
  "author": "Fernan de Dios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandedios/easy-jose.git"
  },
  "homepage": "https://github.com/fernandedios/easy-jose#readme",
  "bugs": {
    "url": "https://github.com/fernandedios/easy-jose/issues"
  },
  "dependencies": {
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
